# ---- Host ports (docker-compose) ----
# Override these to avoid clashing with other solutions on the same machine.
# They only affect the host side; container-internal ports are unchanged.
#   Dashboard  -> http://localhost:${WEB_PORT}
#   API/Swagger-> http://localhost:${API_PORT}/docs
#   Postgres   -> localhost:${DB_PORT}
# NOTE: defaults are deliberately offset from the Prompt-Analyser (5173/8000/5432)
# so both solutions can run side by side on one machine.
WEB_PORT=5174
API_PORT=8001
DB_PORT=5433

# ---- Database ----
# Async SQLAlchemy URL used by the app (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://cowork:cowork@db:5432/cowork

# Credentials for the bundled Postgres container (docker-compose).
POSTGRES_USER=cowork
POSTGRES_PASSWORD=cowork
POSTGRES_DB=cowork

# ---- Security ----
# Signs session/JWT tokens for the password gate. Change in production.
SECRET_KEY=dev-insecure-change-me
# Fernet key for encrypting the Graph client secret at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-run admin bootstrap (only created when no app users exist yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_DIST=frontend/dist

# ---- Ingest tuning ----
# Graph calls issued concurrently (audit paging, user sync).
INGEST_CONCURRENCY=15
# How far back the Purview audit collector reaches on the very first run.
DEFAULT_AUDIT_BACKFILL_DAYS=30
